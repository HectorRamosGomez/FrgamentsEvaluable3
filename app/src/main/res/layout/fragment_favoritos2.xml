<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Favoritos2">

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Opciones como favoritos"
        android:textSize="35dp"
        android:layout_marginTop="100dp"
        android:layout_marginLeft="10dp"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="170dp"
        android:text="opciones:"
        android:textSize="35dp"
        android:layout_marginLeft="10dp"
        />

    <GridLayout
        android:layout_marginTop="240dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:alignmentMode="alignMargins"
        android:columnOrderPreserved="false">

        <ImageButton
            android:id="@+id/btnAnime1"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:scaleType="centerCrop"
            android:src="@drawable/black_clover_portada"
            android:background="?attr/selectableItemBackground" />

        <ImageButton
            android:id="@+id/btnAnime2"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:scaleType="centerCrop"
            android:src="@drawable/frieren_portada"
            android:background="?attr/selectableItemBackground"
            />

        <ImageButton
            android:id="@+id/btnAnime3"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:scaleType="centerCrop"
            android:src="@drawable/oshinoko"
            android:background="?attr/selectableItemBackground" />

        <ImageButton
            android:id="@+id/btnAnime4"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:scaleType="centerCrop"
            android:src="@drawable/haykiu"
            android:background="?attr/selectableItemBackground" />

    </GridLayout>


</FrameLayout>